---
import { hero, heroSpec } from '../data/home-content';
---

<section class="hero gridpaper">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.heading}</h1>
      <p class="lede">{hero.sub}</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        <a class="btn btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
      </div>
    </div>
    <aside class="spec hero__spec" aria-label="Example campaign datasheet">
      <p class="spec__head">{heroSpec.title}</p>
      {heroSpec.rows.map((row) => (
        <div class="spec__row">
          <span class="spec__label">{row.label}</span>
          <span class="spec__value">
            {'live' in row && row.live && <span class="dot dot--live" aria-hidden="true"></span>}
            {row.value}
          </span>
        </div>
      ))}
    </aside>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--line-soft);
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.25fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }
  @media (max-width: 56rem) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__spec { max-width: 28rem; }
  }
</style>
