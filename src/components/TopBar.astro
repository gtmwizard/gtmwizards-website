---
// Utility strip above the main nav — hubsell.com pattern:
// language dropdown (all locales listed) + labeled dark-mode toggle.
import { locales, localeLabels, liveLocales, defaultLocale } from '../i18n/ui';
import { getLangFromUrl, delocalizePath, englishPathFor, localizeRoute } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';

const current = getLangFromUrl(Astro.url);
const englishPath = englishPathFor(delocalizePath(Astro.url.pathname), current);
---

<div class="topbar">
  <div class="container topbar__inner">
    <div class="topbar__spacer"></div>
    <details class="topbar__lang">
      <summary>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        {localeLabels[current]}
      </summary>
      <ul class="topbar__menu">
        {locales.map((loc) => (
          <li>
            <a
              href={liveLocales[loc] || loc === defaultLocale ? localizeRoute(englishPath, loc) : localizeRoute('/', loc)}
              aria-current={loc === current ? 'true' : undefined}
              class:list={{ active: loc === current }}
            >
              {localeLabels[loc]}
              {!liveLocales[loc] && loc !== defaultLocale && <small>soon</small>}
            </a>
          </li>
        ))}
      </ul>
    </details>
    <div class="topbar__group">
      <ThemeToggle />
    </div>
  </div>
</div>

<style>
  .topbar {
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.85rem;
  }
  .topbar {
    overflow: hidden;
    max-height: 3rem;
    transition: max-height 240ms ease, opacity 200ms ease;
  }
  /* hide the utility strip once the page is scrolled; main nav stays */
  :global(.nav.is-scrolled) .topbar {
    max-height: 0;
    opacity: 0;
    border-bottom-width: 0;
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 2.4rem;
    gap: 1.6rem;
  }
  .topbar__spacer { flex: 1; }
  .topbar__lang { position: relative; }
  .topbar__lang summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 500;
  }
  .topbar__lang summary::-webkit-details-marker { display: none; }
  .topbar__lang summary::after { content: '▾'; font-size: 0.7em; opacity: 0.6; }
  .topbar__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 60;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    display: grid;
    min-width: 11rem;
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 40px -24px oklch(0.153 0.006 107.1 / 0.4);
  }
  .topbar__menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-md);
    color: var(--ink);
  }
  .topbar__menu a:hover {
    background: var(--primary);
    color: var(--primary-foreground);
    text-decoration: none;
  }
  .topbar__menu a.active { font-weight: 700; }
  .topbar__menu small {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.65;
  }
  .topbar__group { display: inline-flex; align-items: center; }
  :global(.nav[data-over='dark']) .topbar { border-bottom-color: oklch(1 0 0 / 10%); }
</style>

<script>
  // Close the language dropdown when clicking elsewhere.
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.topbar__lang[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });
</script>
