# Cloudflare Pages env vars (set in the dashboard, not committed)
# --- contact form (functions/api/contact.ts) ---
PLUNK_API_KEY=
CONTACT_TO=hello@gtmwizards.com
# --- assets served from R2 custom domain (src/data/assets.ts) ---
PUBLIC_ASSETS_BASE=https://assets.gtmwizards.com
# --- R2 credentials for scripts/upload-assets.mjs (local machine only) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gtmwizards-assets
