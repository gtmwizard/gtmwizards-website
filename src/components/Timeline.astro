---
import { timeline } from '../data/home-content';
---

<section class="section">
  <div class="container">
    <p class="eyebrow">{timeline.eyebrow}</p>
    <h2>{timeline.heading}</h2>
    <p class="lede">{timeline.sub}</p>
    <ol class="tl">
      {timeline.steps.map((s) => (
        <li class="tl__step card">
          <p class="tl__phase">{s.phase}</p>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .tl {
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem;
  }
  .tl__phase {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-strong);
    margin-bottom: 0.7rem;
  }
  .tl__step p:last-child { margin-bottom: 0; color: var(--ink-soft); font-size: 0.96rem; }
  @media (max-width: 60rem) { .tl { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 40rem) { .tl { grid-template-columns: 1fr; } }
</style>
