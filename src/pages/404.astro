---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="section gridpaper">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>This page doesn't exist</h1>
      <p class="lede">
        The link may be old or mistyped. Everything worth finding is one
        click away.
      </p>
      <p><a class="btn btn--primary" href="/">Back to the homepage</a></p>
    </div>
  </section>
</BaseLayout>
