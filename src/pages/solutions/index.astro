---
import PageLayout from '../../layouts/PageLayout.astro';
import { solutions } from '../../data/solutions-content';
---

<PageLayout
  title="Solutions"
  eyebrow="Solutions"
  heading="Everything outbound needs, from one owner"
  sub="Each capability below runs on hubsell and is operated by our senior team. Together they make a fully managed engine, and every piece of it can eventually be handed over to you."
  description="gtmWizards solutions: lead finding, multichannel outreach, cold calling, deliverability, done-for-you outbound, and the platform handover."
>
  <section class="section--tight section">
    <div class="container grid grid--2">
      {solutions.map((s) => (
        <a class="card sol" href={`/solutions/${s.slug}`}>
          <h3>{s.title}</h3>
          <p>{s.description}</p>
          <span class="sol__more">Read more →</span>
        </a>
      ))}
    </div>
  </section>
</PageLayout>

<style>
  .sol { color: var(--ink); display: block; }
  .sol:hover { text-decoration: none; border-color: var(--brand); }
  .sol p { color: var(--ink-soft); }
  .sol__more { font-weight: 600; color: var(--brand-strong); font-size: 0.94rem; }
</style>
