---
import { proofStrip } from '../data/home-content';
import Sparks from './Sparks.astro';
import SectionRail from './SectionRail.astro';
---

<section class="section section--raised">
  <SectionRail label={proofStrip.label} />
  <Sparks tone="light" density="seam" />
  <div class="container">
    <p class="eyebrow">Provable, not claimed</p>
    <h2>{proofStrip.heading}</h2>
    <div class="grid grid--3 proof">
      {proofStrip.items.map((item) => (
        <article class="card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <a class="proof__link" href={item.href}>{item.linkLabel} →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .proof { margin-top: 1.6rem; }
  .proof__link { font-weight: 600; font-size: 0.94rem; }
</style>
