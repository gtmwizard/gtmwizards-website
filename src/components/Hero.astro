---
import { hero, heroSpec } from '../data/home-content';
import Sparks from './Sparks.astro';
---

<section class="hero section--dark" data-motion-hero>
  <Sparks />
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow" data-motion-item>{hero.eyebrow}</p>
      <h1 data-motion-item>{hero.heading}</h1>
      <p class="lede" data-motion-item>{hero.sub}</p>
      <div class="hero__ctas" data-motion-item>
        <a class="btn btn--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        <a class="btn btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
      </div>
    </div>
    <aside class="spec hero__spec" data-motion-item aria-label="Example campaign datasheet">
      <p class="spec__head">{heroSpec.title}</p>
      {heroSpec.rows.map((row) => (
        <div class="spec__row">
          <span class="spec__label">{row.label}</span>
          <span class="spec__value">
            {'live' in row && row.live && <span class="dot dot--live" aria-hidden="true"></span>}
            {row.value}
          </span>
        </div>
      ))}
    </aside>
  </div>
</section>

<style>
  /* Plum band. .section--dark repaints the tokens, so the eyebrow goes
     lilac, the datasheet turns translucent and the live dot goes bright
     green with no extra rules here. The sparks sit behind everything. */
  .hero {
    position: relative;
    border-bottom: 0;
    padding-block: clamp(4rem, 10vw, 7.5rem);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.25fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }
  @media (max-width: 56rem) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__spec { max-width: 28rem; }
  }
</style>
