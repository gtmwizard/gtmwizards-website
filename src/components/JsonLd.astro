---
import { SITE } from '../data/site';
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  // sameAs is for other URLs that refer to THIS entity. gtmWizards is a
  // service of hubsell UG, so hubsell is the parent, not a sameAs.
  sameAs: [SITE.linkedin],
  parentOrganization: {
    '@type': 'Organization',
    name: 'hubsell UG (haftungsbeschr\u00e4nkt)',
    url: SITE.hubsellUrl,
  },
  knowsLanguage: ['en', 'de'],
};
---

<script type="application/ld+json" set:html={JSON.stringify(org)} />
