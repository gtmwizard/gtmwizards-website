---
import { pillars } from '../data/home-content';
import Sparks from './Sparks.astro';
---

<section class="section">
  <Sparks tone="light" density="seam" />
  <div class="container">
    <p class="eyebrow">{pillars.eyebrow}</p>
    <h2>{pillars.heading}</h2>
    <div class="grid grid--2 pillars">
      {pillars.items.map((item) => (
        <article class="card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pillars { margin-top: 1.6rem; }
  .pillars .card p { margin-bottom: 0; color: var(--ink-soft); }
</style>
