---
// The stack, named. This replaces the old "data by Kadanco" claim: instead of
// pointing at a sibling company, we list the tools we actually run on and say
// what each one does. Copy lives in src/data/home-content.ts.
//
// Deliberately text only, no third-party logos. Logos need permission, they
// date, and a mono list reads more like an engineering spec sheet than a
// partner wall, which is the tone the rest of the page is in.
import { tools } from '../data/home-content';
---

<section class="section section--tight" aria-labelledby="tools-heading">
  <div class="container">
    <p class="eyebrow">{tools.eyebrow}</p>
    <h2 id="tools-heading">{tools.heading}</h2>
    <p class="lede">{tools.sub}</p>

    <ul class="tools">
      {tools.items.map((tool) => (
        <li class="tools__item">
          <span class="tools__name">{tool.name}</span>
          <span class="tools__role">{tool.role}</span>
          <span class="tools__text">{tool.text}</span>
        </li>
      ))}
    </ul>

    <p class="tools__note">{tools.note}</p>
  </div>
</section>

<style>
  .tools {
    list-style: none;
    margin: 2.2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }
  .tools__item {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
  .tools__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .tools__role {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel);
  }
  .tools__text {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .tools__note {
    margin: 1.6rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--steel);
  }

  @media (max-width: 60rem) {
    .tools { grid-template-columns: 1fr; }
  }
</style>
