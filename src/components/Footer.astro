---
import { SITE } from '../data/site';
import { footerNav } from '../data/navigation';
import { ASSETS } from '../data/assets';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <img class="footer__logo-img" src={ASSETS.logoDark} alt={SITE.name} width="125" height="24" loading="lazy" />
        <p class="footer__tag">{SITE.tagline}</p>
        <p class="footer__powered">
          Powered by <a href={SITE.hubsellUrl}>hubsell</a>
        </p>
      </div>
      <div class="footer__cols">
        {footerNav.map((col) => (
          <div>
            <p class="footer__head">{col.heading}</p>
            <ul>
              {col.links.map((l) => (
                <li><a href={l.href}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="footer__bottom">
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <div class="footer__meta">
        <a href={SITE.linkedin} rel="noopener">LinkedIn</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer-bg);
    color: rgba(255, 255, 255, 0.82);
    /* No margin-top. The last section runs straight into the footer, so any
       margin here shows the white body background as a bar. */
    padding-block: clamp(3rem, 6vw, 4.5rem) 1.5rem;
  }
  .footer a { color: #FFFFFF; }
  .footer__top {
    display: grid;
    grid-template-columns: 1.2fr 2.4fr;
    gap: 2.5rem;
  }
  .footer__logo-img { display: block; height: 24px; width: auto; margin-bottom: 0.7rem; }
  .footer__tag { font-size: 0.93rem; max-width: 20rem; }
  .footer__powered {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lilac);
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .footer__head {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lilac);
    margin-bottom: 0.7rem;
  }
  .footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .footer ul a { font-size: 0.9rem; color: rgba(255, 255, 255, 0.82); }
  .footer ul a:hover { color: var(--green); }
  .footer__meta { display: flex; gap: 1.4rem; align-items: center; }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    font-size: 0.85rem;
  }
  @media (max-width: 56rem) {
    .footer__top { grid-template-columns: 1fr; }
    .footer__cols { grid-template-columns: repeat(2, 1fr); }
  }
</style>
