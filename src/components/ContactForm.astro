---
// Posts to the Cloudflare Pages Function at /api/contact.
// Progressive enhancement: works without JS via normal form POST,
// enhanced inline with a small script when JS is available.
---

<form class="cform card" method="POST" action="/api/contact" id="contact-form">
  <div class="cform__row">
    <label>
      Name
      <input name="name" type="text" required autocomplete="name" />
    </label>
    <label>
      Work email
      <input name="email" type="email" required autocomplete="email" />
    </label>
  </div>
  <label>
    Company
    <input name="company" type="text" autocomplete="organization" />
  </label>
  <label>
    What are you selling, and into which market?
    <textarea name="message" rows="5" required></textarea>
  </label>
  <!-- Honeypot: hidden from humans, bots fill it, function rejects it. -->
  <input class="cform__hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <button class="btn btn--primary" type="submit">Send message</button>
  <p class="cform__status" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = form?.querySelector('.cform__status') as HTMLElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = 'Message sent. We reply within one business day.';
    } catch {
      status.textContent =
        'Something went wrong. Email us directly at hello@gtmwizards.com.';
    }
  });
</script>

<style>
  .cform { display: grid; gap: 1rem; max-width: 36rem; }
  .cform label { display: grid; gap: 0.35rem; font-weight: 600; font-size: 0.92rem; }
  .cform input, .cform textarea {
    font: inherit;
    font-weight: 400;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
  }
  .cform input:focus, .cform textarea:focus {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
    border-color: transparent;
  }
  .cform__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .cform__hp { position: absolute; left: -9999px; height: 0; width: 0; border: 0; padding: 0; }
  .cform__status { margin: 0; font-size: 0.92rem; color: var(--steel); min-height: 1.4em; }
  .cform button { justify-self: start; }
  @media (max-width: 40rem) { .cform__row { grid-template-columns: 1fr; } }
</style>
