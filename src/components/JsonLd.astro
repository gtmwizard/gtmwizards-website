---
import { SITE } from '../data/site';
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  // sameAs is for other URLs that refer to THIS entity. Kadanco is the parent
  // company and hubsell is a separate company, so neither belongs there.
  sameAs: [SITE.linkedin],
  parentOrganization: {
    '@type': 'Organization',
    name: 'Kadanco UG (haftungsbeschraenkt)',
    url: SITE.kadancoUrl,
  },
  knowsLanguage: ['en', 'de'],
};
---

<script type="application/ld+json" set:html={JSON.stringify(org)} />
