---
import { SITE } from '../data/site';
import { mainNav } from '../data/navigation';
import { ASSETS } from '../data/assets';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="nav" id="site-header" data-over="base">
  <div class="container nav__inner">
    <a class="nav__logo" href="/" aria-label={`${SITE.name} home`}>
      <img class="nav__logo-img nav__logo-img--light" src={ASSETS.logoLight} alt={SITE.name} width="125" height="24" />
      <img class="nav__logo-img nav__logo-img--dark" src={ASSETS.logoDark} alt="" width="125" height="24" aria-hidden="true" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav__toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav__burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav__links" aria-label="Main">
      {mainNav.map((item) =>
        'links' in item ? (
          <details class="nav__group">
            <summary>{item.label}</summary>
            <div class="nav__dropdown">
              {item.links.map((l) => (
                <a href={l.href}>{l.label}</a>
              ))}
            </div>
          </details>
        ) : (
          <a href={item.href}>{item.label}</a>
        )
      )}
      <ThemeToggle />
      <a class="btn btn--primary nav__cta" href="/book-a-call">Apply for a strategy call</a>
    </nav>
  </div>
</header>

<script>
  // Section-aware header (hubsell.com behavior): the header re-tints to
  // match the section currently beneath it. Sections are classified once,
  // then a rAF-throttled scroll handler picks the one under the header.
  //   base   -> default page background
  //   raised -> muted/raised sections
  //   dark   -> footer and any element with [data-header-theme="dark"]
  const header = document.getElementById('site-header');

  function classify(el: Element): string {
    if (el.matches('[data-header-theme]')) {
      return (el as HTMLElement).dataset.headerTheme || 'base';
    }
    if (el.matches('footer, .footer, .section--dark')) return 'dark';
    if (el.matches('.section--raised')) return 'raised';
    return 'base';
  }

  const candidates = Array.from(
    document.querySelectorAll('main > *, main section, body > footer')
  ).filter((el) => (el as HTMLElement).offsetHeight > 0);

  let ticking = false;
  function update() {
    ticking = false;
    if (!header) return;
    const probe = header.getBoundingClientRect().bottom - 1;
    let theme = 'base';
    for (const el of candidates) {
      const r = el.getBoundingClientRect();
      if (r.top <= probe && r.bottom > probe) theme = classify(el);
    }
    if (header.dataset.over !== theme) header.dataset.over = theme;
    header.classList.toggle('is-scrolled', scrollY > 24);
  }

  addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true }
  );
  addEventListener('resize', update, { passive: true });
  update();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-soft);
    transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease;
  }
  /* section-aware tints */
  .nav[data-over='raised'] {
    background: color-mix(in srgb, var(--surface-alt) 90%, transparent);
    border-bottom-color: var(--line);
  }
  .nav[data-over='dark'] {
    background: color-mix(in srgb, var(--plum-deep) 92%, transparent);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    --line: rgba(255, 255, 255, 0.18);
    --line-soft: rgba(255, 255, 255, 0.10);
    --steel: var(--lilac);
    --accent: rgba(255, 255, 255, 0.08);
    --ring: var(--green);
  }
  .nav[data-over='dark'] .nav__links > a,
  .nav[data-over='dark'] .nav__group summary { color: #FFFFFF; }
  .nav[data-over='dark'] .nav__burger span { background: #FFFFFF; }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4rem;
  }
  .nav__logo { display: inline-flex; align-items: center; }
  .nav__logo:hover { text-decoration: none; }
  .nav__logo-img { display: block; height: 24px; width: auto; }
  .nav__logo-img--dark { display: none; }
  /* swap the wordmark when the header sits over a dark section, and
     whenever the whole site is in dark mode */
  .nav[data-over='dark'] .nav__logo-img--light,
  :global(html.dark) .nav__logo-img--light { display: none; }
  .nav[data-over='dark'] .nav__logo-img--dark,
  :global(html.dark) .nav__logo-img--dark { display: block; }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-left: auto;
  }
  .nav__links > a {
    color: var(--ink);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .nav__links > a.nav__cta,
  .nav[data-over='dark'] .nav__links > a.nav__cta {
    color: var(--primary-foreground);
  }

  .nav__group { position: relative; }
  .nav__group summary {
    list-style: none;
    cursor: pointer;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .nav__group summary::-webkit-details-marker { display: none; }
  .nav__group summary::after { content: ' ▾'; font-size: 0.7em; opacity: 0.6; }
  .nav__dropdown {
    position: absolute;
    top: calc(100% + 0.7rem);
    left: 50%;
    translate: -50% 0;
    background: var(--popover);
    color: var(--popover-foreground);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 40px -24px var(--shadow-colour);
    padding: 0.5rem;
    display: grid;
    min-width: 17rem;
  }
  .nav__dropdown a {
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-md);
    color: var(--ink);
    font-size: 0.93rem;
  }
  /* menuAccent: bold (preset), filled hover state */
  .nav__dropdown a:hover {
    background: var(--primary);
    color: var(--primary-foreground);
    text-decoration: none;
  }

  .nav__toggle, .nav__burger { display: none; }

  @media (max-width: 56rem) {
    .nav__burger {
      display: grid;
      gap: 4px;
      margin-left: auto;
      cursor: pointer;
      padding: 0.5rem;
    }
    .nav__burger span {
      width: 20px;
      height: 2px;
      background: var(--ink);
      border-radius: 2px;
    }
    .nav__links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--paper-raised);
      border-bottom: 1px solid var(--line);
      flex-direction: column;
      align-items: stretch;
      padding: 1rem clamp(1.1rem, 4vw, 2rem) 1.4rem;
      gap: 0.9rem;
    }
    .nav__toggle:checked ~ .nav__links { display: flex; }
    .nav[data-over='dark'] .nav__links > a,
    .nav[data-over='dark'] .nav__group summary { color: var(--ink); }
    .nav__group summary { padding-block: 0.2rem; }
    .nav__dropdown {
      position: static;
      translate: none;
      box-shadow: none;
      border: 0;
      padding: 0.2rem 0 0 0.8rem;
      min-width: 0;
      background: transparent;
    }
    .nav__cta { justify-content: center; }
  }
</style>
