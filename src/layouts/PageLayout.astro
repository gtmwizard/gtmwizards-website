---
// Simple inner-page layout: page header + slotted content.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  heading?: string;
  sub?: string;
  eyebrow?: string;
  /** Forwarded to BaseLayout so inner pages can set their own share card. */
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  heading = title,
  sub,
  eyebrow,
  ogImage,
  ogImageAlt,
  noindex,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  noindex={noindex}
>
  <header class="section section--tight">
    <div class="container">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{heading}</h1>
      {sub && <p class="lede">{sub}</p>}
    </div>
  </header>
  <slot />
</BaseLayout>
