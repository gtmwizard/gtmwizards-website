---
import Sparks from './Sparks.astro';

interface Props {
  heading: string;
  tone?: 'base' | 'dark';
  sub?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  heading,
  tone = 'base',
  sub,
  primaryLabel = 'Apply for a strategy call',
  primaryHref = '/book-a-call',
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class:list={['section', 'cta-band', { 'section--dark': tone === 'dark' }]}>
  {tone === 'dark' && <Sparks />}
  <div class="container">
    <div class:list={['cta', { gridpaper: tone !== 'dark' }]}>
      <h2>{heading}</h2>
      {sub && <p class="lede">{sub}</p>}
      <div class="cta__actions">
        <a class="btn btn--primary" href={primaryHref}>{primaryLabel}</a>
        {secondaryLabel && secondaryHref && (
          <a class="btn btn--ghost" href={secondaryHref}>{secondaryLabel}</a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* On the dark tone the grid paper is replaced by the spark layer, so the
     plum CTA band matches the plum hero at the top of the page. */
  .cta-band { position: relative; }
  .cta-band > .container { position: relative; z-index: 1; }
  .cta {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 5vw, 3.5rem);
    background-color: var(--card);
    text-align: left;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.4rem;
  }
</style>
